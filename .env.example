# Tavla Dashboard — environment variables
# Copy to `.env.local` and adjust for your backend instance.
# Never commit real credentials.

# Versioned API root (must include /api/v1). No trailing slash required.
#
# Local dashboard against production API (recommended — avoids CORS):
VITE_API_BASE_URL=/api/v1
VITE_DEV_API_PROXY_TARGET=https://api.tavola.business
#
# Absolute URL (production build / Postman / scripts):
# VITE_API_BASE_URL=https://api.tavola.business/api/v1
#
# Local backend:
# VITE_API_BASE_URL=http://localhost:3000/api/v1
# VITE_DEV_API_PROXY_TARGET=http://localhost:3000

# Optional — enables OneSignal identity-token bootstrap after auth (no SDK loaded):
# VITE_ONESIGNAL_APP_ID=your-onesignal-app-id
