# Tavla Dashboard — environment variables
# Copy to `.env.local` and adjust for your backend instance.
# Never commit real credentials or production-only hosts.

# Versioned API root (must include /api/v1). No trailing slash required.
# - Local backend on the same machine: http://localhost:3000/api/v1
# - Remote backend that blocks localhost CORS: use /api/v1 and set VITE_DEV_API_PROXY_TARGET
VITE_API_BASE_URL=/api/v1

# Used only by Vite's /api proxy during `npm run dev` (see vite.config.ts).
# Ignored in production builds — production must use an absolute VITE_API_BASE_URL
# that the browser is allowed to call (same origin or CORS-enabled host).
VITE_DEV_API_PROXY_TARGET=http://localhost:3000
